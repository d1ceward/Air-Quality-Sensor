#!/usr/bin/env bash
set -eo pipefail;

release_func() {
  if [[ $(git branch | grep \* | cut -d ' ' -f2) != "master" ]]; then
    echo -e "\033[0;31m===>\033[0m Not on master branch !"
    echo -e "\033[0;31m=>\033[0m Please change to master branch..."
    exit 1;
  fi

  if ! $(git diff-index --quiet HEAD --); then
    echo -e "\033[0;31m===>\033[0m Uncommitted changes !"
    echo -e "\033[0;31m=>\033[0m Please commit changes before..."
    exit 1;
  fi

  # The build workflow refuses a tag that does not match PROJECT_VERSION, so the number has to be complete
  if [[ ! "${1}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo -e "\033[0;31m===>\033[0m Need an version number !"
    echo -e "\033[0;31m=>\033[0m Please give version like 1.5.0"
    exit 1;
  fi

  sed -i "s/^constexpr char PROJECT_VERSION\[\] = \".*/constexpr char PROJECT_VERSION[] = \"${1}\";/" include/config.h
  sed -i "s/^# Air Quality Sensor (v.*/# Air Quality Sensor (v${1})/" README.md
  sed -i "s/Air Quality Sensor firmware [0-9.]*\. Metrics/Air Quality Sensor firmware ${1}. Metrics/" grafana/dashboard.json

  git add include/config.h README.md grafana/dashboard.json
  git commit -m "Bump version number to v${1}"
  git push origin master

  git tag "v${1}"
  git push --tags
}

release_func "${@}"
